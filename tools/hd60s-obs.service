# systemd user unit: keeps the HD60 S fed into v4l2loopback and a PipeWire sink.
# Install to ~/.config/systemd/user/ and adjust ExecStart to your checkout.
# Pair it with a udev rule so it starts on hotplug, for example:
#   SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0fd9", \
#     ATTR{idProduct}=="0076", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}="hd60s-obs.service"
[Unit]
Description=Elgato HD60 S into v4l2loopback and PipeWire
After=pipewire.service pipewire-pulse.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=%h/Projekte/hd60s-linux/tools/hd60s-obs
Restart=on-failure
RestartSec=3
# FFmpeg can ignore SIGTERM while blocked on an output; do not wait long.
TimeoutStopSec=5

[Install]
WantedBy=default.target
