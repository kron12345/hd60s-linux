#!/usr/bin/env bash
# Feeds the HD60 S into a v4l2loopback device and a PipeWire/PulseAudio sink, so
# OBS, browsers and other V4L2 clients see an ordinary camera and the audio
# appears as "Monitor of Elgato HD60 S".
#
# Prerequisites: v4l2loopback loaded with exclusive_caps=1 (see README), ffmpeg,
# pactl. Environment overrides: HD60S_VIDEO_DEV, HD60S_SINK, HD60S_BIN.
set -euo pipefail

video_dev="${HD60S_VIDEO_DEV:-/dev/video10}"
sink="${HD60S_SINK:-hd60s}"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bin="${HD60S_BIN:-$here/../target/release/hd60s-linux}"
[[ -x "$bin" ]] || bin="$(command -v hd60s-linux || true)"
[[ -n "$bin" && -x "$bin" ]] || { echo "error: hd60s-linux binary not found (build with cargo build --release)" >&2; exit 1; }

[[ -e "$video_dev" ]] || {
  echo "error: $video_dev is missing; load v4l2loopback (modprobe v4l2loopback video_nr=10 exclusive_caps=1)" >&2
  exit 1
}

# Virtual sink for the embedded audio; OBS records its monitor source.
if ! pactl list short sinks | awk '{print $2}' | grep -qx "$sink"; then
  pactl load-module module-null-sink sink_name="$sink" \
    sink_properties=device.description="Elgato\ HD60\ S" >/dev/null
fi

fifo="$(mktemp -u /tmp/hd60s-audio.XXXXXX)"
mkfifo -m 600 "$fifo"
trap 'rm -f "$fifo"' EXIT
# Hold the FIFO open read-write so neither side blocks on open().
exec 3<>"$fifo"

# v4l2loopback advertises 30 fps to clients unless told otherwise.
v4l2-ctl -d "$video_dev" -p 60 >/dev/null 2>&1 || true

echo "feeding $video_dev (video) and sink '$sink' (audio) from $bin" >&2
# Both inputs are fully described on the command line; skipping FFmpeg's
# probing shortens startup. (The capture itself never blocks on its outputs,
# which is what keeps the two-input pipeline from deadlocking.)
"$bin" capture --audio "$fifo" | ffmpeg -hide_banner -loglevel warning -nostats \
  -probesize 32 -analyzeduration 0 -thread_queue_size 1024 \
  -f s16le -ar 48000 -ac 2 -i "$fifo" \
  -probesize 32 -analyzeduration 0 -thread_queue_size 1024 \
  -f rawvideo -pix_fmt yuyv422 -s 1920x1080 -r 60 -i - \
  -map 1:v -c:v rawvideo -pix_fmt yuyv422 -fps_mode passthrough -f v4l2 "$video_dev" \
  -map 0:a -c:a pcm_s16le -f pulse -device "$sink" "HD60 S capture"
