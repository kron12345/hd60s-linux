# Elgato Game Capture HD60 S, all four hardware revisions.
# uaccess: the user at the local seat may open the device without root.
# Nothing is started automatically: HD60 S Control runs the service while
# it is open and offers autostart choices (desktop or systemd).
SUBSYSTEM=="usb", ATTR{idVendor}=="0fd9", ATTR{idProduct}=="004f", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0fd9", ATTR{idProduct}=="005e", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0fd9", ATTR{idProduct}=="0074", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0fd9", ATTR{idProduct}=="0076", TAG+="uaccess"
